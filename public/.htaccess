<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave AutoSSL / ACME validation alone
  RewriteRule ^\.well-known/ - [L]

  # One canonical host: https://monrepossokobanja.com (no www, no http)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://monrepossokobanja.com/$1 [R=301,L]

  # /index.html and /page/index.html -> clean trailing-slash URL
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

ErrorDocument 404 /404.html
